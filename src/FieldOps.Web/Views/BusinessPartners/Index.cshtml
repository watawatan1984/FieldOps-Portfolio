@model FieldOps.Features.Parties.PartyIndexViewModel
@using FieldOps.Domain.Enums
@using FieldOps.Web.Formatting
@{
    ViewData["Title"] = "協力会社";
    int previousPage = Math.Max(1, Model.Page - 1);
    int nextPage = Math.Min(Model.TotalPages, Model.Page + 1);
}

<nav aria-label="現在位置">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">ホーム</a></li>
        <li class="breadcrumb-item active" aria-current="page">協力会社</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1>協力会社を探す</h1>
        <p class="page-intro mb-1">この画面では協力会社を探し、詳しい情報を確認できます。</p>
        <p class="text-body-secondary mb-0">担当支店: <strong>@Model.BranchName</strong></p>
    </div>
    <a class="btn btn-primary" asp-controller="Parties" asp-action="Create" asp-route-branchId="@Model.BranchId">新しい協力会社を登録する</a>
</div>

<form method="get" class="row g-2 mb-4" role="search">
    <input type="hidden" name="branchId" value="@Model.BranchId" />
    <div class="col-md-8">
        <label class="form-label" for="partner-search">会社名・担当者名・現場名で検索</label>
        <input class="form-control" id="partner-search" name="search" value="@Model.Search" />
    </div>
    <div class="col-md-4 align-self-end">
        <button class="btn btn-primary" type="submit">この条件で探す</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="app-empty-state" role="status">条件に合う協力会社はまだありません。</p>
}
else
{
    <div class="responsive-records d-none d-lg-block">
        <table class="table align-middle bg-white">
            <thead>
                <tr>
                    <th scope="col">会社名</th>
                    <th scope="col">区分</th>
                    <th scope="col">主な担当者</th>
                    <th scope="col">主な現場</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var party in Model.Items)
            {
                <tr>
                    <th scope="row"><a asp-controller="Parties" asp-action="Details" asp-route-id="@party.Id" asp-route-branchId="@Model.BranchId">@party.DisplayName</a></th>
                    <td><span class="badge text-bg-secondary">@UiDisplayText.ForPartyRole(PartyRoleType.BusinessPartner)</span></td>
                    <td>@(party.PrimaryContact ?? "未登録")</td>
                    <td>@(party.PrimarySite ?? "未登録")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="row g-3 d-lg-none">
    @foreach (var party in Model.Items)
    {
        <div class="col-12 col-md-6">
            <article class="card task-card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">@party.DisplayName</h2>
                    <p class="mb-2"><span class="badge text-bg-secondary">@UiDisplayText.ForPartyRole(PartyRoleType.BusinessPartner)</span></p>
                    <p class="mb-1">担当者: @(party.PrimaryContact ?? "未登録")</p>
                    <p class="mb-3">現場: @(party.PrimarySite ?? "未登録")</p>
                    <a class="btn btn-outline-primary" asp-controller="Parties" asp-action="Details" asp-route-id="@party.Id" asp-route-branchId="@Model.BranchId">協力会社の情報を見る</a>
                </div>
            </article>
        </div>
    }
    </div>
}

<nav aria-label="協力会社のページ" class="d-flex flex-wrap align-items-center gap-2 mt-3">
    <span class="text-body-secondary">全@Model.TotalCount件</span>
    <ul class="pagination mb-0">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
            <a class="page-link" href="@Url.Action("Index", new { branchId = Model.BranchId, search = Model.Search, page = previousPage, pageSize = Model.PageSize })">前へ</a>
        </li>
        @for (int page = 1; page <= Model.TotalPages; page++)
        {
            <li class="page-item @(page == Model.Page ? "active" : null)">
                <a class="page-link" href="@Url.Action("Index", new { branchId = Model.BranchId, search = Model.Search, page, pageSize = Model.PageSize })">@(page)</a>
            </li>
        }
        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
            <a class="page-link" href="@Url.Action("Index", new { branchId = Model.BranchId, search = Model.Search, page = nextPage, pageSize = Model.PageSize })">次へ</a>
        </li>
    </ul>
</nav>
