@model FieldOps.Features.Sales.SalesIndexViewModel
@using FieldOps.Domain.Enums
@using FieldOps.Infrastructure.Identity
@{
    ViewData["Title"] = "Sales opportunities";
    bool canCreate = !User.IsInRole(DemoRoleNames.FieldTechnician);
}

<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Dashboard</a></li><li class="breadcrumb-item active" aria-current="page">Sales</li></ol></nav>
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1>Sales opportunities</h1><p class="text-body-secondary mb-0">Branch scope: <strong>@Model.BranchName</strong></p></div>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create" asp-route-branchId="@Model.Filters.BranchId">Create opportunity</a> }
</div>

<form method="get" class="row g-2 mb-4" role="search">
    <input type="hidden" name="branchId" value="@Model.Filters.BranchId" />
    <div class="col-md-4"><label for="sales-search" class="form-label">Party or site</label><input id="sales-search" class="form-control" name="search" value="@Model.Filters.Search" /></div>
    <div class="col-md-4"><label for="owner" class="form-label">Owner</label><select id="owner" class="form-select" name="ownerUserId"><option value="">All owners</option>@foreach (var owner in Model.Owners) { <option value="@owner.Id" selected="@(owner.Id == Model.Filters.OwnerUserId)">@owner.DisplayName</option> }</select></div>
    <div class="col-md-4"><label for="status" class="form-label">Status</label><select id="status" class="form-select" name="status"><option value="">All statuses</option>@foreach (SalesOpportunityStatus status in Enum.GetValues<SalesOpportunityStatus>()) { <option value="@status" selected="@(status == Model.Filters.Status)">@status</option> }</select></div>
    <div class="col-md-3"><label for="close-from" class="form-label">Expected close from</label><input id="close-from" type="date" class="form-control" name="expectedCloseFrom" value="@Model.Filters.ExpectedCloseFrom?.ToString("yyyy-MM-dd")" /></div>
    <div class="col-md-3"><label for="close-to" class="form-label">Expected close to</label><input id="close-to" type="date" class="form-control" name="expectedCloseTo" value="@Model.Filters.ExpectedCloseTo?.ToString("yyyy-MM-dd")" /></div>
    <div class="col-md-3"><label for="amount-min" class="form-label">Minimum amount</label><input id="amount-min" type="number" step="0.01" class="form-control" name="minimumAmount" value="@Model.Filters.MinimumAmount" /></div>
    <div class="col-md-3"><label for="amount-max" class="form-label">Maximum amount</label><input id="amount-max" type="number" step="0.01" class="form-control" name="maximumAmount" value="@Model.Filters.MaximumAmount" /></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Filter</button></div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info" role="status">No sales opportunities match these filters.</div>
}
else
{
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">Party</th><th scope="col">Site</th><th scope="col">Owner</th><th scope="col">Status</th><th scope="col">Amount</th><th scope="col">Expected close</th></tr></thead><tbody>
    @foreach (var opportunity in Model.Items)
    {
        <tr><th scope="row"><a asp-action="Details" asp-route-id="@opportunity.Id">@opportunity.PartyName</a></th><td>@opportunity.SiteName</td><td>@opportunity.OwnerName</td><td>@opportunity.Status</td><td>@(opportunity.ProposedAmount?.ToString("C") ?? "Not set")</td><td>@(opportunity.ExpectedCloseDate?.ToString("yyyy-MM-dd") ?? "Not set")</td></tr>
    }
    </tbody></table></div>
}

<nav aria-label="Sales opportunity pages"><ul class="pagination">@for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++) { <li class="page-item @(pageNumber == Model.Page ? "active" : null)"><a class="page-link" href="@Url.Action("Index", new { branchId = Model.Filters.BranchId, ownerUserId = Model.Filters.OwnerUserId, status = Model.Filters.Status, expectedCloseFrom = Model.Filters.ExpectedCloseFrom?.ToString("yyyy-MM-dd"), expectedCloseTo = Model.Filters.ExpectedCloseTo?.ToString("yyyy-MM-dd"), minimumAmount = Model.Filters.MinimumAmount, maximumAmount = Model.Filters.MaximumAmount, search = Model.Filters.Search, page = pageNumber, pageSize = Model.PageSize })">@pageNumber</a></li> }</ul></nav>
