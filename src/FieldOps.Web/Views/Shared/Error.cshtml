@model ErrorViewModel
@{
    ViewData["Title"] = "エラー";
}

<section class="app-empty-state">
    <h1>処理を完了できませんでした</h1>
    <p>時間をおいて、もう一度お試しください。</p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>お問い合わせ番号:</strong> <code>@Model.RequestId</code>
        </p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">ホームへ戻る</a>
</section>
