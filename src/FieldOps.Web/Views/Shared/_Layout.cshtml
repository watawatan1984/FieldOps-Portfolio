<!DOCTYPE html>
@using FieldOps.Web.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    bool canViewDashboard = (await AuthorizationService.AuthorizeAsync(User, Policies.ViewDashboard)).Succeeded;
    bool canManageParties = (await AuthorizationService.AuthorizeAsync(User, Policies.ManageParties)).Succeeded;
    bool canReadSales = (await AuthorizationService.AuthorizeAsync(User, Policies.ReadSales)).Succeeded;
    bool canReadWorkOrders = (await AuthorizationService.AuthorizeAsync(User, Policies.ReadWorkOrders)).Succeeded;
    bool canViewAudit = (await AuthorizationService.AuthorizeAsync(User, Policies.ViewAudit)).Succeeded;
    bool canResetDemo = (await AuthorizationService.AuthorizeAsync(User, Policies.ResetDemo)).Succeeded;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FieldOps Portal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FieldOps.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">FieldOps Portal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (canViewDashboard)
                        {
                            <li class="nav-item" data-policy="@Policies.ViewDashboard">
                                <a class="nav-link text-dark" href="/">Dashboard</a>
                            </li>
                        }
                        @if (canManageParties)
                        {
                            <li class="nav-item" data-policy="@Policies.ManageParties">
                                <a class="nav-link text-dark" href="/parties">Parties</a>
                            </li>
                        }
                        @if (canReadSales)
                        {
                            <li class="nav-item" data-policy="@Policies.ReadSales">
                                <a class="nav-link text-dark" href="/sales">Sales</a>
                            </li>
                        }
                        @if (canReadWorkOrders)
                        {
                            <li class="nav-item" data-policy="@Policies.ReadWorkOrders">
                                <a class="nav-link text-dark" href="/work-orders">Work orders</a>
                            </li>
                        }
                        @if (canViewAudit)
                        {
                            <li class="nav-item" data-policy="@Policies.ViewAudit">
                                <a class="nav-link text-dark" href="/audit">Audit</a>
                            </li>
                        }
                        @if (canResetDemo)
                        {
                            <li class="nav-item" data-policy="@Policies.ResetDemo">
                                <a class="nav-link text-dark" href="/demo-reset">Reset demo</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - FieldOps Portal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
