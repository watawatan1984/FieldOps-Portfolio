@model FieldOps.Features.Parties.EditPartyInput
@using FieldOps.Domain.Enums
@using FieldOps.Features.Parties
@using FieldOps.Web.Formatting
@{
    ViewData["Title"] = "顧客情報を変更";
    var branches = (IReadOnlyList<BranchOption>)(ViewData["Branches"] ?? Array.Empty<BranchOption>());
}

<nav aria-label="現在位置">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">ホーム</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-branchId="@Model.BranchId">顧客・協力会社</a></li>
        <li class="breadcrumb-item active" aria-current="page">変更</li>
    </ol>
</nav>

<h1>顧客情報を変更する</h1>
<p class="page-intro">担当支店: <strong>@ViewData["BranchName"]</strong></p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card task-card mb-4">
    <div class="card-body">
        @if (ViewData["PartyError"] is string partyError)
        {
            <div class="alert alert-danger" role="alert">@partyError</div>
        }
        <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>
        <input asp-for="Id" type="hidden" />
        <input asp-for="BranchId" type="hidden" />
        <input asp-for="Version" type="hidden" />

        <div class="mb-3">
            <label asp-for="OrganizationName" class="form-label"></label>
            <span class="badge text-bg-danger ms-1">必須</span>
            <input asp-for="OrganizationName" class="form-control" autofocus />
            <span asp-validation-for="OrganizationName" class="text-danger"></span>
        </div>

        <fieldset class="mb-4">
            <legend class="h5">登録区分</legend>
            @if (Model.IsCustomer)
            {
                <input asp-for="IsCustomer" type="hidden" value="true" />
                <div class="form-check">
                    <input id="existing-customer" class="form-check-input" type="checkbox" checked disabled />
                    <label for="existing-customer" class="form-check-label">@UiDisplayText.ForPartyRole(PartyRoleType.Customer)（登録済み）</label>
                </div>
            }
            else
            {
                <div class="form-check">
                    <input asp-for="IsCustomer" class="form-check-input" />
                    <label asp-for="IsCustomer" class="form-check-label"></label>
                </div>
            }
            @if (Model.IsBusinessPartner)
            {
                <input asp-for="IsBusinessPartner" type="hidden" value="true" />
                <div class="form-check">
                    <input id="existing-business-partner" class="form-check-input" type="checkbox" checked disabled />
                    <label for="existing-business-partner" class="form-check-label">@UiDisplayText.ForPartyRole(PartyRoleType.BusinessPartner)（登録済み）</label>
                </div>
            }
            else
            {
                <div class="form-check">
                    <input asp-for="IsBusinessPartner" class="form-check-input" />
                    <label asp-for="IsBusinessPartner" class="form-check-label"></label>
                </div>
            }
            <p class="form-text">登録済みの区分は保持されます。この画面では追加だけできます。</p>
        </fieldset>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">変更内容を保存する</button>
            <a asp-action="Index" asp-route-branchId="@Model.BranchId" class="btn btn-link">前の画面へ戻る</a>
        </div>
    </div>
</form>

@if (branches.Any(branch => !Model.AssignedBranchIds.Contains(branch.Id)))
{
    <details class="details-disclosure" open>
        <summary>ほかの支店にも共有する</summary>
        <form asp-action="Share" asp-route-id="@Model.Id" method="post" class="mt-3">
            <input name="BranchId" type="hidden" value="@Model.BranchId" />
            <input name="Version" type="hidden" value="@Model.Version" />
            <div class="mb-3">
                <label for="TargetBranchId" class="form-label">共有先の支店</label>
                <select id="TargetBranchId" name="TargetBranchId" class="form-select">
                    <option value="">支店を選んでください</option>
                    @foreach (BranchOption branch in branches.Where(branch => !Model.AssignedBranchIds.Contains(branch.Id)))
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                </select>
                @Html.ValidationMessage("TargetBranchId", null, new { @class = "text-danger" })
            </div>
            <button type="submit" class="btn btn-outline-primary">この支店にも共有する</button>
        </form>
    </details>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
