@model FieldOps.Features.Parties.EditPartyInput
@using FieldOps.Features.Parties
@{
    ViewData["Title"] = "Edit party";
    var branches = (IReadOnlyList<BranchOption>)(ViewData["Branches"] ?? Array.Empty<BranchOption>());
}

<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Dashboard</a></li><li class="breadcrumb-item"><a asp-action="Index" asp-route-branchId="@Model.BranchId">Parties</a></li><li class="breadcrumb-item active" aria-current="page">Edit</li></ol></nav>
<h1>Edit party</h1>
<p class="text-body-secondary">Branch scope: <strong>@ViewData["BranchName"]</strong></p>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>
    <input asp-for="Id" type="hidden" /><input asp-for="BranchId" type="hidden" /><input asp-for="Version" type="hidden" />
    <div class="mb-3"><label asp-for="OrganizationName" class="form-label"></label><input asp-for="OrganizationName" class="form-control" autofocus /><span asp-validation-for="OrganizationName" class="text-danger"></span></div>
    <fieldset class="mb-3">
        <legend class="h5">Roles</legend>
        @if (Model.IsCustomer)
        {
            <input asp-for="IsCustomer" type="hidden" value="true" />
            <div class="form-check"><input id="existing-customer" class="form-check-input" type="checkbox" checked disabled /><label for="existing-customer" class="form-check-label">Customer (existing)</label></div>
        }
        else
        {
            <div class="form-check"><input asp-for="IsCustomer" class="form-check-input" /><label asp-for="IsCustomer" class="form-check-label"></label></div>
        }
        @if (Model.IsBusinessPartner)
        {
            <input asp-for="IsBusinessPartner" type="hidden" value="true" />
            <div class="form-check"><input id="existing-business-partner" class="form-check-input" type="checkbox" checked disabled /><label for="existing-business-partner" class="form-check-label">Business partner (existing)</label></div>
        }
        else
        {
            <div class="form-check"><input asp-for="IsBusinessPartner" class="form-check-input" /><label asp-for="IsBusinessPartner" class="form-check-label"></label></div>
        }
        <p class="form-text">Existing roles are retained. You can add a second role here.</p>
    </fieldset>
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Index" asp-route-branchId="@Model.BranchId" class="btn btn-link">Cancel</a>
</form>
@if (branches.Any(branch => !Model.AssignedBranchIds.Contains(branch.Id)))
{
    <hr /><h2 class="h4">Share with another branch</h2>
    <form asp-action="Share" asp-route-id="@Model.Id" method="post">
        <input name="BranchId" type="hidden" value="@Model.BranchId" /><input name="Version" type="hidden" value="@Model.Version" />
        <div class="mb-3">
            <label for="TargetBranchId" class="form-label">Target branch</label>
            <select id="TargetBranchId" name="TargetBranchId" class="form-select">
                <option value="">Select a branch</option>
                @foreach (BranchOption branch in branches.Where(branch => !Model.AssignedBranchIds.Contains(branch.Id)))
                {
                    <option value="@branch.Id">@branch.Name</option>
                }
            </select>
            @Html.ValidationMessage("TargetBranchId", null, new { @class = "text-danger" })
        </div>
        <button type="submit" class="btn btn-outline-primary">Share party</button>
    </form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
