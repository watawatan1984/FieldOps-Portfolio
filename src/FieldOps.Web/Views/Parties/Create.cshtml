@model FieldOps.Features.Parties.CreatePartyInput
@using FieldOps.Domain.Enums
@using FieldOps.Web.Formatting
@{
    string title = ViewData["CreateTitle"] as string ?? "顧客・協力会社を登録";
    string heading = ViewData["CreateHeading"] as string ?? "顧客・協力会社を登録する";
    string submitText = ViewData["CreateSubmit"] as string ?? "この内容で登録する";
    ViewData["Title"] = title;
}

<nav aria-label="現在位置">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">ホーム</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-branchId="@Model.BranchId">顧客・協力会社</a></li>
        <li class="breadcrumb-item active" aria-current="page">登録</li>
    </ol>
</nav>

<h1>@heading</h1>
<p class="page-intro">担当支店 <strong>@ViewData["BranchName"]</strong> に、顧客または協力会社の基本情報を登録します。</p>

<form asp-action="Create" method="post" class="card task-card">
    <div class="card-body">
        @if (ViewData["PartyError"] is string partyError)
        {
            <div class="alert alert-danger" role="alert">@partyError</div>
        }
        <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>
        <input asp-for="BranchId" type="hidden" />

        <div class="mb-3">
            <label asp-for="OrganizationName" class="form-label"></label>
            <span class="badge text-bg-danger ms-1">必須</span>
            <input asp-for="OrganizationName" class="form-control" autofocus />
            <span asp-validation-for="OrganizationName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoleType" class="form-label"></label>
            <span class="badge text-bg-danger ms-1">必須</span>
            <select asp-for="RoleType" class="form-select">
                <option value="">選んでください</option>
                <option value="@PartyRoleType.Customer" selected="@(Model.RoleType == PartyRoleType.Customer ? "selected" : null)">@UiDisplayText.ForPartyRole(PartyRoleType.Customer)</option>
                <option value="@PartyRoleType.BusinessPartner" selected="@(Model.RoleType == PartyRoleType.BusinessPartner ? "selected" : null)">@UiDisplayText.ForPartyRole(PartyRoleType.BusinessPartner)</option>
            </select>
            <span asp-validation-for="RoleType" class="text-danger"></span>
        </div>

        <fieldset class="mb-3">
            <legend class="h5">主な連絡先</legend>
            <p class="text-body-secondary">担当者名が分かる場合だけ入力します。</p>
            <div class="row g-2">
                <div class="col-sm-6">
                    <label asp-for="ContactLastName" class="form-label"></label>
                    <input asp-for="ContactLastName" class="form-control" />
                    <span asp-validation-for="ContactLastName" class="text-danger"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ContactFirstName" class="form-label"></label>
                    <input asp-for="ContactFirstName" class="form-control" />
                    <span asp-validation-for="ContactFirstName" class="text-danger"></span>
                </div>
            </div>
        </fieldset>

        <div class="mb-4">
            <label asp-for="SiteName" class="form-label"></label>
            <input asp-for="SiteName" class="form-control" />
            <span asp-validation-for="SiteName" class="text-danger"></span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">@submitText</button>
            <a asp-action="Index" asp-route-branchId="@Model.BranchId" class="btn btn-link">前の画面へ戻る</a>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
