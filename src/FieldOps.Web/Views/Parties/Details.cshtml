@model FieldOps.Features.Parties.PartyDetailsViewModel
@using FieldOps.Domain.Enums
@using FieldOps.Web.Formatting
@{
    ViewData["Title"] = Model.DisplayName;
    string partyKindLabel = Model.PartyKind == "Organization" ? "組織" : "個人";
}

<nav aria-label="現在位置">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">ホーム</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-branchId="@Model.BranchId">顧客・協力会社</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.DisplayName</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1>@Model.DisplayName</h1>
        <p class="text-body-secondary mb-2">担当支店: <strong>@Model.BranchName</strong></p>
        <p class="mb-0">
            <span class="badge text-bg-light">@partyKindLabel</span>
            @if (Model.IsCustomer) { <span class="badge text-bg-primary">@UiDisplayText.ForPartyRole(PartyRoleType.Customer)</span> }
            @if (Model.IsBusinessPartner) { <span class="badge text-bg-secondary">@UiDisplayText.ForPartyRole(PartyRoleType.BusinessPartner)</span> }
        </p>
    </div>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id" asp-route-branchId="@Model.BranchId">顧客情報を変更する</a>
</div>

<div class="row g-3">
    <section class="col-md-4" aria-labelledby="contacts-heading">
        <article class="card task-card h-100">
            <div class="card-body">
                <h2 id="contacts-heading" class="h4">連絡先</h2>
                @if (Model.Contacts.Count == 0)
                {
                    <p class="app-empty-state mb-0" role="status">連絡先はまだ登録されていません。</p>
                }
                else
                {
                    <ul class="mb-0">
                    @foreach (string contact in Model.Contacts)
                    {
                        <li>@contact</li>
                    }
                    </ul>
                }
            </div>
        </article>
    </section>
    <section class="col-md-4" aria-labelledby="sites-heading">
        <article class="card task-card h-100">
            <div class="card-body">
                <h2 id="sites-heading" class="h4">現場</h2>
                @if (Model.Sites.Count == 0)
                {
                    <p class="app-empty-state mb-0" role="status">この支店の現場はまだ登録されていません。</p>
                }
                else
                {
                    <ul class="mb-0">
                    @foreach (string site in Model.Sites)
                    {
                        <li>@site</li>
                    }
                    </ul>
                }
            </div>
        </article>
    </section>
    <section class="col-md-4" aria-labelledby="branches-heading">
        <article class="card task-card h-100">
            <div class="card-body">
                <h2 id="branches-heading" class="h4">担当支店</h2>
                @if (Model.AssignedBranches.Count == 0)
                {
                    <p class="app-empty-state mb-0" role="status">担当支店はまだ登録されていません。</p>
                }
                else
                {
                    <ul class="mb-0">
                    @foreach (string branch in Model.AssignedBranches)
                    {
                        <li>@branch</li>
                    }
                    </ul>
                }
            </div>
        </article>
    </section>
</div>
