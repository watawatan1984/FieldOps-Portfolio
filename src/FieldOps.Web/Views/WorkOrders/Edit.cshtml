@model WorkOrderScheduleForm
@using FieldOps.Features.Work
@{
    ViewData["Title"] = "日程と担当者を決める";
    WorkOrderEditorOptions options = (WorkOrderEditorOptions)ViewData["EditorOptions"]!;
}

<nav aria-label="現在位置">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">ホーム</a></li>
        <li class="breadcrumb-item"><a href="/work-orders">作業予定</a></li>
        <li class="breadcrumb-item active" aria-current="page">日程と担当者</li>
    </ol>
</nav>

<div class="mb-3">
    <h1>日程と担当者を決める</h1>
    <p class="page-intro mb-1">@options.PartyName · @options.SiteName</p>
    <p class="text-body-secondary mb-0">担当支店: <strong>@options.BranchName</strong></p>
</div>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="post" class="row g-3">
    <input asp-for="Id" type="hidden" />
    <input asp-for="Version" type="hidden" />
    <input asp-for="Status" type="hidden" />
    <div class="col-md-6">
        <label asp-for="AssignedUserId" class="form-label"></label>
        <select asp-for="AssignedUserId" class="form-select">
            <option value="">担当者を選択</option>
            @foreach (var technician in options.Technicians)
            {
                <option value="@technician.Id">@technician.DisplayName</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="ScheduledDate" class="form-label"></label>
        <input asp-for="ScheduledDate" type="date" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="ScheduledTime" class="form-label"></label>
        <input asp-for="ScheduledTime" type="time" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit"
                class="btn btn-primary"
                data-confirm-action
                data-confirm-title="日程と担当者を保存しますか"
                data-confirm-target="@options.PartyName"
                data-confirm-message="状態を「予定あり」に変更します。"
                data-confirm-impact="保存後、担当者はこの作業予定を開始できるようになります。">日程と担当者を保存する</button>
        <a class="btn btn-outline-secondary ms-2" href="/work-orders/@Model.Id">前の画面へ戻る</a>
    </div>
</form>
