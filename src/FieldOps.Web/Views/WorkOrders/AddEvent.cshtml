@model WorkEventForm
@using FieldOps.Domain.Enums
@{
    ViewData["Title"] = "作業記録を追加する";
    IReadOnlyList<WorkEventType> eventTypes = (IReadOnlyList<WorkEventType>)ViewData["EventTypes"]!;
    string workOrderId = ViewContext.RouteData.Values["id"]?.ToString() ?? string.Empty;
}

<nav aria-label="現在位置">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">ホーム</a></li>
        <li class="breadcrumb-item"><a href="/work-orders">作業予定</a></li>
        <li class="breadcrumb-item active" aria-current="page">作業記録</li>
    </ol>
</nav>

<h1>作業記録を追加する</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="post" class="row g-3">
    <input asp-for="Version" type="hidden" />
    <div class="col-md-4">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            @foreach (var eventType in eventTypes)
            {
                <option value="@eventType">@UiDisplayText.ForWorkEventType(eventType)</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="OccurredDate" class="form-label"></label>
        <input asp-for="OccurredDate" type="date" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="OccurredTime" class="form-label"></label>
        <input asp-for="OccurredTime" type="time" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="Summary" class="form-label"></label>
        <textarea asp-for="Summary" class="form-control" rows="5"></textarea>
    </div>
    <div class="col-12">
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="/work-orders/@workOrderId">前の画面へ戻る</a>
            <button type="submit" class="btn btn-primary">作業記録を保存する</button>
        </div>
    </div>
</form>
