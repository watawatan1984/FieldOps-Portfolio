@model FieldOps.Features.Dashboard.BranchProgressItem
@{
    ViewData["Title"] = Model.BranchName;
}

<h1>@Model.BranchName</h1>
<p class="page-intro">@JapanTimeFormatter.FormatUtc(Model.Metrics.AsOfUtc) 時点の支店状況です。</p>
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3" aria-label="支店の集計">
    <div class="col"><section class="card h-100" data-metric="overdue-work" data-value="@Model.Metrics.OverdueWork"><div class="card-body"><h2 class="h6">遅延件数</h2><p class="display-6">@Model.Metrics.OverdueWork</p></div></section></div>
    <div class="col"><section class="card h-100" data-metric="open-opportunities" data-value="@Model.Metrics.OpenOpportunities"><div class="card-body"><h2 class="h6">未対応の営業案件</h2><p class="display-6">@Model.Metrics.OpenOpportunities</p></div></section></div>
    <div class="col"><section class="card h-100" data-metric="proposals-due" data-value="@Model.Metrics.ProposalsDue"><div class="card-body"><h2 class="h6">提案期限</h2><p class="display-6">@Model.Metrics.ProposalsDue</p></div></section></div>
    <div class="col"><section class="card h-100" data-metric="scheduled-work" data-value="@Model.Metrics.ScheduledWork"><div class="card-body"><h2 class="h6">予定あり</h2><p class="display-6">@Model.Metrics.ScheduledWork</p></div></section></div>
    <div class="col"><section class="card h-100" data-metric="work-in-progress" data-value="@Model.Metrics.WorkInProgress"><div class="card-body"><h2 class="h6">作業中</h2><p class="display-6">@Model.Metrics.WorkInProgress</p></div></section></div>
    <div class="col"><section class="card h-100" data-metric="completions-this-month" data-value="@Model.Metrics.CompletionsThisMonth"><div class="card-body"><h2 class="h6">今月の完了</h2><p class="display-6">@Model.Metrics.CompletionsThisMonth</p></div></section></div>
</div>
@if (Model.Metrics.IsEmpty)
{
    <p class="app-empty-state mt-4" role="status">この支店では、今すぐ表示する業務集計がありません。</p>
}
