@model IReadOnlyList<DemoRoleCardViewModel>
@{
    ViewData["Title"] = "デモログイン";
}

<h1>担当する仕事を選んでください</h1>
<p>架空のデモデータを使って、担当範囲ごとの操作を確認できます。</p>

<div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (DemoRoleCardViewModel card in Model)
    {
        <div class="col">
            <section class="card h-100">
                <div class="card-body">
                    <h2 class="h5">@card.RoleLabel</h2>
                    <p class="mb-1">@card.DisplayName</p>
                    <p class="text-muted">@card.Description</p>
                    <form method="post" asp-controller="DemoLogin" asp-action="Index" data-role="@card.Role">
                        <input type="hidden" name="roleToken" value="@card.LoginToken" />
                        <button class="btn btn-primary" type="submit">@(card.RoleLabel)として始める</button>
                    </form>
                </div>
            </section>
        </div>
    }
</div>
