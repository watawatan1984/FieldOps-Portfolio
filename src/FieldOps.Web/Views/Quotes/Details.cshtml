@model FieldOps.Features.Quotes.QuoteDetailsViewModel
@using FieldOps.Domain.Enums
@{
    ViewData["Title"] = Model.QuoteNumber;
}

<nav aria-label="現在位置">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">ホーム</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-branchId="@Model.BranchId">見積</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.QuoteNumber</li>
    </ol>
</nav>

<div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1>@Model.QuoteNumber<span class="fs-6 text-body-secondary"> （第@(Model.RevisionNumber)版）</span></h1>
        <p class="text-body-secondary mb-1">@Model.PartyName · @Model.SiteName · @Model.BranchName</p>
        <p class="mb-0">@SummaryText()</p>
    </div>
    <span class="badge text-bg-primary fs-6">@UiDisplayText.ForQuoteStatus(Model.Status)</span>
</div>

<p><a class="btn btn-outline-primary" asp-action="Pdf" asp-route-id="@Model.Id">見積書をPDFで出力</a></p>

<section class="card task-card mb-3" aria-labelledby="quote-summary-heading">
    <div class="card-body">
        <h2 id="quote-summary-heading" class="h5">見積の要点</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3">顧客</dt>
            <dd class="col-sm-9">@Model.PartyName</dd>
            <dt class="col-sm-3">現場</dt>
            <dd class="col-sm-9">@Model.SiteName</dd>
            <dt class="col-sm-3">営業担当者</dt>
            <dd class="col-sm-9">@Model.OwnerName</dd>
            <dt class="col-sm-3">有効期限</dt>
            <dd class="col-sm-9">@FormatDate(Model.ValidUntil)</dd>
            <dt class="col-sm-3">発行日</dt>
            <dd class="col-sm-9">@FormatDate(Model.IssuedOn)</dd>
            <dt class="col-sm-3">備考</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "なし" : Model.Notes)</dd>
        </dl>
    </div>
</section>

<section class="card task-card mb-3" aria-labelledby="quote-line-items-heading">
    <div class="card-body">
        <h2 id="quote-line-items-heading" class="h5">明細</h2>
        <div class="responsive-records">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">品名</th>
                        <th scope="col">単位</th>
                        <th scope="col">数量</th>
                        <th scope="col">単価</th>
                        <th scope="col">金額</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var lineItem in Model.LineItems)
                {
                    <tr>
                        <th scope="row">@lineItem.Description</th>
                        <td>@lineItem.UnitName</td>
                        <td>@lineItem.Quantity</td>
                        <td>@FormatAmount(lineItem.UnitPrice)</td>
                        <td>@FormatAmount(lineItem.Amount)</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row" colspan="4">小計</th>
                        <td>@FormatAmount(Model.Subtotal)</td>
                    </tr>
                    <tr>
                        <th scope="row" colspan="4">消費税（@Model.TaxRatePercent%）</th>
                        <td>@FormatAmount(Model.TaxAmount)</td>
                    </tr>
                    <tr>
                        <th scope="row" colspan="4">合計</th>
                        <td>@FormatAmount(Model.TotalAmount)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</section>

@if (Model.CanManage && Model.Status == QuoteStatus.Draft)
{
    <p><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">見積を編集する</a></p>
}

@if (Model.CanManage && Model.AllowedTransitions.Count > 0)
{
    <section aria-labelledby="transitions-heading" class="mb-3">
        <h2 id="transitions-heading" class="h4">次の行動</h2>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var status in Model.AllowedTransitions)
            {
                string statusLabel = UiDisplayText.ForQuoteStatus(status);
                <form asp-action="Transition" asp-route-id="@Model.Id" method="post">
                    <input name="Version" type="hidden" value="@Model.Version" />
                    <input name="NextStatus" type="hidden" value="@status" />
                    <button type="submit"
                            class="btn @(status == QuoteStatus.Accepted ? "btn-success" : "btn-outline-primary")"
                            data-confirm-action="true"
                            data-confirm-title="見積の状態を変更しますか"
                            data-confirm-target="@Model.QuoteNumber"
                            data-confirm-message="この見積を@(statusLabel)にします。"
                            data-confirm-impact="変更後も監査履歴に記録され、画面の状態が更新されます。">この見積を@(statusLabel)にする</button>
                </form>
            }
        </div>
    </section>
}

@if (Model.CanViewAudit)
{
    <details class="details-disclosure mt-4">
        <summary>詳しい変更履歴を見る</summary>
        @if (Model.AuditEntries.Count == 0)
        {
            <p class="mb-0">変更履歴はまだありません。</p>
        }
        else
        {
            <ol class="mb-0">
                @foreach (var audit in Model.AuditEntries)
                {
                    <li>
                        <time datetime="@audit.OccurredAtUtc.ToString("O")">@JapanTimeFormatter.FormatUtc(audit.OccurredAtUtc)</time>
                        <span> @UiDisplayText.ForAuditAction(audit.Action)（@UiDisplayText.ForAuditOutcome(audit.Outcome)）</span>
                        <span> 変更項目: @(string.IsNullOrEmpty(audit.ChangedFields) ? "なし" : UiDisplayText.ForAuditFields(audit.ChangedFields))</span>
                    </li>
                }
            </ol>
        }
    </details>
}

@functions {
    private static readonly System.Globalization.CultureInfo JapaneseCulture = System.Globalization.CultureInfo.GetCultureInfo("ja-JP");

    private static string FormatAmount(decimal? amount) =>
        amount?.ToString("C0", JapaneseCulture) ?? "未入力";

    private static string FormatDate(DateTime? date) =>
        date?.ToString("yyyy年M月d日", JapaneseCulture) ?? "未入力";

    private string SummaryText()
    {
        string status = UiDisplayText.ForQuoteStatus(Model.Status);
        string validUntil = FormatDate(Model.ValidUntil);
        if (Model.CanManage && Model.AllowedTransitions.Count > 0)
        {
            return $"見積は{status}です。有効期限は{validUntil}、次の行動を下から選びます。";
        }

        return $"見積は{status}です。有効期限は{validUntil}です。";
    }
}
