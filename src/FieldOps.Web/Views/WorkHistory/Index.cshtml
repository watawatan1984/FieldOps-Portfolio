@model FieldOps.Web.Models.WorkHistorySearchViewModel
@using FieldOps.Domain.Enums
@{
    ViewData["Title"] = "Work history";
    string PageUrl(int page) => Url.Action("Index", "WorkHistory", new
    {
        Model.BranchId,
        Model.CustomerId,
        Model.BusinessPartnerId,
        Model.SiteId,
        Model.WorkStatus,
        Model.EventType,
        Model.TechnicianId,
        Model.ScheduledFrom,
        Model.ScheduledTo,
        Model.CompletedFrom,
        Model.CompletedTo,
        Model.Keyword,
        Page = page,
        PageSize = Model.EffectivePageSize
    })!;
}
<h1>Work history</h1>
<form method="get" class="row g-2 mb-4">
    @if (Model.CanSelectBranch)
    {
        <div class="col-md-3"><label asp-for="BranchId" class="form-label">Branch</label><select asp-for="BranchId" class="form-select"><option value="">All branches</option>@foreach (var option in Model.Branches) { <option value="@option.Id">@option.Name</option> }</select></div>
    }
    else if (Model.BranchId.HasValue)
    {
        <input asp-for="BranchId" type="hidden" />
    }
    <div class="col-md-3"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">All customers</option>@foreach (var option in Model.Customers) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-3"><label asp-for="BusinessPartnerId" class="form-label">Business partner</label><select asp-for="BusinessPartnerId" class="form-select"><option value="">All business partners</option>@foreach (var option in Model.BusinessPartners) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-3"><label asp-for="SiteId" class="form-label">Site</label><select asp-for="SiteId" class="form-select"><option value="">All sites</option>@foreach (var option in Model.Sites) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-3"><label asp-for="WorkStatus" class="form-label">Work status</label><select asp-for="WorkStatus" class="form-select"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<WorkOrderStatus>()) { <option value="@status">@status</option> }</select></div>
    <div class="col-md-3"><label asp-for="EventType" class="form-label">Event type</label><select asp-for="EventType" class="form-select"><option value="">All event types</option>@foreach (var eventType in Enum.GetValues<WorkEventType>()) { <option value="@eventType">@eventType</option> }</select></div>
    <div class="col-md-3"><label asp-for="TechnicianId" class="form-label">Technician</label><select asp-for="TechnicianId" class="form-select"><option value="">All technicians</option>@foreach (var option in Model.Technicians) { <option value="@option.Id">@option.DisplayName</option> }</select></div>
    <div class="col-md-3"><label asp-for="ScheduledFrom" class="form-label">Scheduled from</label><input asp-for="ScheduledFrom" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="ScheduledTo" class="form-label">Scheduled to</label><input asp-for="ScheduledTo" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="CompletedFrom" class="form-label">Completed from</label><input asp-for="CompletedFrom" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="CompletedTo" class="form-label">Completed to</label><input asp-for="CompletedTo" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Keyword" class="form-label">Keyword</label><input asp-for="Keyword" class="form-control" /></div>
    <input name="PageSize" value="@Model.EffectivePageSize" type="hidden" />
    <div class="col-md-2 align-self-end"><button type="submit" class="btn btn-primary">Search</button></div>
</form>
@if (Model.Items.Count == 0)
{
    <div class="alert alert-info" role="status">No work history matches these filters.</div>
}
else
{
    <p>@Model.TotalCount result(s)</p>
    <div class="table-responsive"><table class="table"><thead><tr><th>Customer</th><th>Site</th><th>Branch</th><th>Scheduled</th><th>Completed</th><th>Technician</th><th>Status</th></tr></thead><tbody>
    @foreach (var item in Model.Items)
    {
        <tr><td><a href="/work-orders/@item.Id">@item.CustomerName</a></td><td>@item.SiteName</td><td>@item.BranchName</td><td>@(item.ScheduledStartUtc?.ToString("u") ?? "Not scheduled")</td><td>@(item.CompletionDateUtc?.ToString("u") ?? "Not completed")</td><td>@(item.AssignedUserName ?? "Not assigned")</td><td>@item.Status</td></tr>
    }
    </tbody></table></div>
}
@if (Model.TotalPages > 1)
{
    int firstPage = Math.Max(1, Model.Page - 2);
    int lastPage = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Work history pages"><ul class="pagination">
        @for (int page = firstPage; page <= lastPage; page++)
        {
            <li class="page-item @(page == Model.Page ? "active" : null)"><a class="page-link" href="@PageUrl(page)">@(page)</a></li>
        }
    </ul></nav>
}
